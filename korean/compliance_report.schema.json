{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:korean-sds:2026-26:report",
  "title": "Evidence-based Korean SDS compliance report",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string"
    },
    "review_basis": {
      "type": "string"
    },
    "scope_result": {
      "type": "string",
      "enum": [
        "IN_SCOPE",
        "OUT_OF_SCOPE",
        "UNCERTAIN"
      ]
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NEEDS_REVIEW",
        "NOT_APPLICABLE"
      ]
    },
    "sds_document_status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NEEDS_REVIEW",
        "NOT_APPLICABLE"
      ]
    },
    "summary_ko": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "status",
          "source_refs",
          "evidence",
          "reason_ko",
          "action_ko"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "NEEDS_REVIEW",
              "NOT_APPLICABLE"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sds_page_or_section": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "reason_ko": {
            "type": "string"
          },
          "action_ko": {
            "type": "string"
          },
          "missing_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "annex_source_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "annex_field_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification_method": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewer_approval_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "UNREVIEWED",
              "REVIEWED",
              "DISPUTED",
              null
            ]
          }
        }
      }
    },
    "missing_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "annexes_not_provided": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "external_law_validation_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_scope_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "annex_review_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "annex",
          "review_status"
        ],
        "properties": {
          "annex": {
            "type": "string",
            "pattern": "^별표 [1-7]$"
          },
          "review_status": {
            "type": "string",
            "enum": [
              "REVIEWED",
              "PARTIAL",
              "NOT_ASSESSED"
            ]
          },
          "checks_verified": {
            "type": "integer",
            "minimum": 0
          },
          "source_layout_verified": {
            "type": "boolean"
          },
          "source_revision_verified": {
            "type": "boolean"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "out_of_scope_checks": {
      "type": "array",
      "description": "Requirements outside the review boundary (NOT_ASSESSED), distinguished from statutory NOT_APPLICABLE.",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "document_id",
    "review_basis",
    "scope_result",
    "overall_status",
    "sds_document_status",
    "summary_ko",
    "findings",
    "missing_inputs",
    "annexes_not_provided",
    "external_law_validation_required",
    "review_scope_limitations"
  ]
}
