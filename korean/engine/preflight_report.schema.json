{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:korean-sds:preflight-v1:report",
  "title": "Korean SDS preflight observations — not a compliance verdict",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "document_id",
    "engine",
    "overall_status",
    "legal_compliance_determined",
    "source_version_verified",
    "section_structure",
    "annex_4_fields",
    "annex_5_uses",
    "annex_6_composition_thresholds",
    "annex_3_label_measurements",
    "msds_number",
    "limitations"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "engine": {
      "const": "KOREAN_SDS_PREFLIGHT_V1"
    },
    "overall_status": {
      "const": "NEEDS_REVIEW"
    },
    "legal_compliance_determined": {
      "const": false
    },
    "source_version_verified": {
      "const": false
    },
    "section_structure": {
      "type": "object",
      "required": [
        "checks",
        "observed_order",
        "extraction_complete"
      ],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "observation",
              "source_ref"
            ]
          }
        },
        "observed_order": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "extraction_complete": {
          "type": "boolean"
        }
      }
    },
    "annex_4_fields": {
      "type": "object",
      "required": [
        "checks",
        "count_by_observation"
      ],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field_id",
              "observation",
              "source_ref"
            ]
          }
        },
        "count_by_observation": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "annex_5_uses": {
      "type": "object",
      "required": [
        "observation",
        "known",
        "unknown"
      ]
    },
    "annex_6_composition_thresholds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component_index",
          "observation"
        ]
      }
    },
    "annex_3_label_measurements": {
      "type": "object",
      "required": [
        "observation"
      ]
    },
    "msds_number": {
      "type": "object",
      "required": [
        "observation",
        "source_ref"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source_manifest": {
      "type": "object"
    },
    "review_scope": {
      "type": "string"
    }
  }
}
