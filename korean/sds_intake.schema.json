{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:korean-sds:2026-26:intake",
  "title": "Korean SDS review intake",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "document_id": {
      "type": "string"
    },
    "source_sds_filename": {
      "type": [
        "string",
        "null"
      ]
    },
    "notice_basis": {
      "const": "2026-26"
    },
    "review_scope": {
      "type": "string",
      "enum": [
        "SDS_DOCUMENT_ONLY",
        "SDS_AND_LABEL",
        "FULL_WITH_OPERATIONS"
      ]
    },
    "product": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_mixture": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_research_reagent": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "is_finished_article": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "is_research_intermediate": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "annex_5_use_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)?$"
          },
          "description": "Annex 5 category codes selected with product-use evidence; codes do not themselves imply an SDS exemption."
        },
        "is_submission_context": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "manufacturer_or_importer_role": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sds": {
      "type": "object",
      "properties": {
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "number",
              "heading_ko",
              "text"
            ],
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "heading_ko": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "page_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "description": "Preserve physical source order and source page references, if obtainable."
        },
        "translated_from_foreign_sds": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "original_authoring_institution": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_creation_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "section_fields": {
          "type": "array",
          "description": "Source-anchored field extraction using annex_4_sds_field_requirements.json field_id values. Extracted text is evidence, not legal validation.",
          "items": {
            "type": "object",
            "required": [
              "field_id",
              "source_text"
            ],
            "properties": {
              "field_id": {
                "type": "string",
                "pattern": "^KR-A4-S\\d{2}-"
              },
              "section_no": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "source_text": {
                "type": "string"
              },
              "source_page": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_span": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "extraction_confidence": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "extraction_complete": {
          "type": "boolean",
          "description": "Explicit assertion that all pages, numbered sections and detailed Annex 4 fields have been completely extracted; do not set true without quality review. Missing values are NOT_ASSESSED otherwise."
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chemical_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "cas_no": {
            "type": [
              "string",
              "null"
            ]
          },
          "reported_min_pct": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "reported_max_pct": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "actual_pct": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "alternative_name_used": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "hazard_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authority_approval_reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "confirmed_hazard_categories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "hazard_name_ko": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                },
                "classification_source": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "annex_6_omission_claim": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "applicable_disclosure_threshold_percent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "physical_hazard_group_under_rule_annex_18_1a": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Qualified reviewer-attested membership in implementing-rule Annex 18 §1(a); null means unverified, false is not inferred from absence."
          }
        }
      }
    },
    "label": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "container_capacity_liters": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "printed_label_area_cm2": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "exterior_side_surface_area_cm2": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "pictogram_areas_cm2": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "description": "Actual measured container/label dimensions; not derived from SDS text."
    },
    "operations": {
      "type": [
        "object",
        "null"
      ]
    },
    "supporting_law": {
      "type": "object",
      "properties": {
        "annex_1": {
          "type": [
            "string",
            "null"
          ]
        },
        "annex_2": {
          "type": [
            "string",
            "null"
          ]
        },
        "annex_3": {
          "type": [
            "string",
            "null"
          ]
        },
        "annex_4": {
          "type": [
            "string",
            "null"
          ]
        },
        "annex_5": {
          "type": [
            "string",
            "null"
          ]
        },
        "annex_6": {
          "type": [
            "string",
            "null"
          ]
        },
        "annex_7": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "approvals": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object"
      }
    },
    "reviewer_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "msds_submission": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "submission_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "government_submission_confirmed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "document_number_on_first_page": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "first_page_number_position": {
          "type": [
            "string",
            "null"
          ]
        },
        "authorised_exemption_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority_confirmation_evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "required": [
    "document_id",
    "review_scope",
    "product",
    "sds"
  ]
}
